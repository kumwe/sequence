{
  "name": "kumwe/sequence",
  "description": "Portable document numbering: format, reset and scope values and the storage-neutral allocator port.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/sequence",
  "support": {
    "issues": "https://github.com/kumwe/sequence/issues",
    "source": "https://github.com/kumwe/sequence"
  },
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Sequence\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Sequence\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer:validate": "composer validate --strict",
    "audit": "composer audit --abandoned=fail",
    "release:check": "bash tools/test-release-record.sh",
    "lint": "php tools/lint.php",
    "docs": "php tools/check-docblocks.php",
    "architecture": "php tools/verify-architecture.php",
    "manifests": "php tools/verify-manifests.php",
    "manifests:record": "php tools/verify-manifests.php --write",
    "autoload:smoke": "php resources/toolchain/autoload-smoke.php",
    "examples": "php examples/allocate-and-render.php",
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "php tests/run.php",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "check": [
      "@composer:validate",
      "@audit",
      "@release:check",
      "@lint",
      "@docs",
      "@architecture",
      "@manifests",
      "@autoload:smoke",
      "@examples",
      "@cs",
      "@analyse",
      "@test",
      "@clean-consumer"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
